// Nexus — Multi-Vendor E-Commerce & Delivery Platform
// Prisma Schema v2.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
  DELIVERY_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  VENDOR
  DELIVERY_PARTNER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Better Auth Required Models ─────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
}

// ─── Core User ───────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CUSTOMER)
  totalSpent    Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth
  accounts    Account[]
  sessions    Session[]

  // Business relations
  vendor          Vendor?
  deliveryPartner DeliveryPartner?
  orders          Order[]
  addresses       Address[]
  roleRequests    RoleRequest[]
  notifications   Notification[]

  @@index([email])
  @@index([role])
}

// ─── Role Request System ─────────────────────────────────────────────────────

model RoleRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      RequestType
  status    RequestStatus @default(PENDING)

  // Vendor fields
  shopName        String?
  shopDescription String?
  businessType    String?
  phoneNumber     String?
  bankName        String?
  bankAccountName String?
  bankAccountNumber String?

  // Delivery Partner fields
  vehicleType   String?
  licenseNumber String?
  nidNumber     String?
  nidImage      String?

  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ─── Vendor ──────────────────────────────────────────────────────────────────

model Vendor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopName          String
  shopDescription   String?
  shopImage         String?
  shopBanner        String?
  phoneNumber       String
  businessType      String
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?

  balance            Float @default(0)
  totalEarnings      Float @default(0)
  platformCommission Float @default(10) // percentage

  isVerified Boolean @default(true)
  isActive   Boolean @default(true)

  products  Product[]
  orders    VendorOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Delivery Partner ────────────────────────────────────────────────────────

model DeliveryPartner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber    String
  vehicleType    String
  licenseNumber  String
  nidNumber      String?
  nidImage       String?

  isVerified      Boolean @default(true)
  isActive        Boolean @default(true)
  isAvailable     Boolean @default(true)
  rating          Float   @default(5.0)
  totalDeliveries Int     @default(0)
  totalEarnings   Float   @default(0)

  deliveries Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isVerified, isAvailable])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name          String
  description   String
  price         Float
  discountPrice Float?
  image         String?
  images        String[] @default([])
  category      String
  tags          String[] @default([])
  stock         Int      @default(0)
  rating        Float    @default(0)
  totalSold     Int      @default(0)
  isActive      Boolean  @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([category])
  @@index([isActive])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderNumber     String      @unique @default(cuid())
  totalAmount     Float
  subtotal        Float
  shippingCharge  Float       @default(80) // 80 = Dhaka, 120 = Outside Dhaka
  city            String      // Used to determine shipping charge
  shippingAddress String
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  stripePaymentId String?

  // Delivery assignment (set by Vendor)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  deliveredAt DateTime?

  items        OrderItem[]
  vendorOrders VendorOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([deliveryPartnerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Float
  subtotal Float

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model VendorOrder {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  subtotal   Float
  commission Float
  vendorEarning Float
  status     OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId])
}

// ─── Platform Revenue ────────────────────────────────────────────────────────

model PlatformRevenue {
  id      String @id @default(cuid())
  orderId String
  amount  Float
  type    String @default("commission") // commission, fee

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  street     String
  city       String
  state      String
  postalCode String
  country    String  @default("Bangladesh")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String  @default("info") // info, success, warning, error
  isRead  Boolean @default(false)
  link    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
