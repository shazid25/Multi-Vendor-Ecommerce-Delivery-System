// Green Mart - Multi-Vendor E-Commerce & Delivery Management System
// Prisma Schema – Compatible with Prisma 6.15.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  VENDOR
  DELIVERY_PARTNER
  ADMIN
  SUPER_ADMIN
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleRequestType {
  VENDOR
  DELIVERY_PARTNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum LocationZone {
  DHAKA
  OUTSIDE_DHAKA
}

// ==================== MODELS ====================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  password              String?
  image                 String?
  phone                 String?
  role                  UserRole  @default(CUSTOMER)
  emailVerified         DateTime? // ✅ Changed to DateTime? for Better Auth
  lastLogin             DateTime?
  isActive              Boolean   @default(true)
  
  totalSpent            Float     @default(0)
  platformBalance       Float     @default(0)
  totalPlatformRevenue  Float     @default(0)
  
  accounts              Account[]
  sessions              Session[]
  
  addresses             Address[]
  orders                Order[]
  vendor                Vendor?
  deliveryPartner       DeliveryPartner?
  roleRequests          RoleRequest[]
  transactions          Transaction[]
  notifications         Notification[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("user")
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model RoleRequest {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  requestType           RoleRequestType
  status                RoleRequestStatus @default(PENDING)
  
  shopName              String?
  shopDescription       String?
  businessType          String?
  shopImage             String?
  phoneNumber           String?
  
  vehicleType           String?
  licenseNumber         String?
  licenseExpiry         DateTime?
  nidNumber             String?
  nidImage              String?
  
  reviewedBy            String?
  reviewedAt            DateTime?
  rejectionReason       String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestType])
}

model Vendor {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shopName              String
  shopDescription       String?
  shopImage             String?
  shopBanner            String?
  phoneNumber           String
  businessType          String
  
  balance               Float     @default(0)
  totalSales            Float     @default(0)
  platformCommission    Float     @default(10)
  
  bankAccountName       String?
  bankAccountNumber     String?
  bankName              String?
  routingNumber         String?
  
  isVerified            Boolean   @default(false)
  isActive              Boolean   @default(true)
  rating                Float     @default(5.0)
  totalOrders           Int       @default(0)
  
  products              Product[]
  orders                VendorOrder[]
  deliveryAssignments   DeliveryAssignment[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([isVerified])
}

model DeliveryPartner {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phoneNumber           String
  vehicleType           String
  licenseNumber         String
  licenseExpiry         DateTime
  nidNumber             String
  nidImage              String?
  
  totalEarnings         Float     @default(0)
  availableBalance      Float     @default(0)
  totalDeliveries       Int       @default(0)
  
  isVerified            Boolean   @default(false)
  isActive              Boolean   @default(true)
  isAvailable           Boolean   @default(true)
  rating                Float     @default(5.0)
  
  deliveries            Delivery[]
  deliveryAssignments   DeliveryAssignment[]
  earnings              DeliveryEarning[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([isVerified])
  @@index([isAvailable])
}

model Product {
  id                    String    @id @default(cuid())
  vendorId              String
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  name                  String
  description           String
  price                 Float
  discountPrice         Float?
  image                 String?
  images                String[]  @default([])
  category              String
  stock                 Int       @default(0)
  isActive              Boolean   @default(true)
  
  totalSold             Int       @default(0)
  rating                Float     @default(5.0)
  
  orderItems            OrderItem[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([vendorId])
  @@index([category])
  @@index([isActive])
}

model Order {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderNumber           String    @unique
  
  shippingAddress       String
  city                  String
  zone                  LocationZone
  shippingCharge        Float
  
  subtotal              Float
  totalAmount           Float
  platformCommission    Float     @default(0)
  
  status                OrderStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  
  deliveryAssignmentId  String?
  deliveryAssignment    DeliveryAssignment?
  
  items                 OrderItem[]
  delivery              Delivery?
  vendorOrders          VendorOrder[]
  transactions          Transaction[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id                    String    @id @default(cuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId             String
  product               Product   @relation(fields: [productId], references: [id])
  
  quantity              Int
  price                 Float
  subtotal              Float
  
  createdAt             DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
}

model VendorOrder {
  id                    String    @id @default(cuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  vendorId              String
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  vendorAmount          Float
  commissionAmount      Float
  status                OrderStatus @default(PENDING)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([orderId, vendorId])
  @@index([orderId])
  @@index([vendorId])
}

model DeliveryAssignment {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  vendorId              String
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  deliveryPartnerId     String
  deliveryPartner       DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
  
  assignedAt            DateTime  @default(now())
  
  delivery              Delivery?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([deliveryPartnerId])
}

model Delivery {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  assignmentId          String    @unique
  assignment            DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  deliveryPartnerId     String
  deliveryPartner       DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
  
  status                DeliveryStatus @default(ASSIGNED)
  pickupTime            DateTime?
  deliveryTime          DateTime?
  rating                Float?
  feedback              String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([status])
}

model DeliveryEarning {
  id                    String    @id @default(cuid())
  deliveryPartnerId     String
  deliveryPartner       DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  
  orderId               String
  amount                Float
  earnedAt              DateTime  @default(now())
  
  createdAt             DateTime  @default(now())

  @@index([deliveryPartnerId])
  @@index([earnedAt])
}

model Transaction {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId               String?
  order                 Order?    @relation(fields: [orderId], references: [id])
  
  type                  String
  amount                Float
  description           String?
  
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Address {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  street                String
  city                  String
  state                 String
  postalCode            String
  country               String
  phone                 String?
  isDefault             Boolean   @default(false)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Notification {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  message               String
  type                  String    @default("info")
  isRead                Boolean   @default(false)
  link                  String?
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

// ==================== BETTER AUTH MODELS ====================

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==================== CMS ====================

model Banner {
  id        String   @id @default(cuid())
  image     String
  title     String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}